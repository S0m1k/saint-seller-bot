# ==== Telegram bot ====
# Токен бота от @BotFather
BOT_TOKEN=123456:PUT-YOUR-TOKEN-HERE

# Telegram ID администраторов через запятую (узнать свой id можно у @userinfobot)
ADMIN_IDS=123456789

# ==== Web App ====
# Публичный HTTPS-адрес, на котором развёрнут этот сервер (webapp + api).
# Для кнопки Telegram Web App обязателен https в проде.
# Локально для теста в браузере можно оставить http://localhost:8000
WEBAPP_URL=https://your-domain.example

# ==== API / сервер ====
API_HOST=0.0.0.0
API_PORT=8000

# ==== База данных ====
# По умолчанию SQLite-файл в корне проекта
DATABASE_URL=sqlite+aiosqlite:///./saint_seller.db

# ==== Разработка ====
# DEBUG=true разрешает открывать webapp в обычном браузере без Telegram initData.
# В этом режиме используется пользователь DEV_USER_ID (по умолчанию первый ADMIN_IDS).
DEBUG=false
# DEV_USER_ID=123456789
